{
  "name": "solaris-launcher",
  "productName": "Solaris",
  "version": "1.7.0",
  "description": "Solaris — a fast, modern Minecraft: Java Edition launcher",
  "main": "main.js",
  "author": "Solaris",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "icon": "node tools/make-icon.js",
    "dist": "electron-builder --win nsis",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux AppImage deb --x64",
    "predist": "node tools/check-release.js",
    "predist:mac": "node tools/check-release.js",
    "predist:linux": "node tools/check-release.js"
  },
  "build": {
    "appId": "app.solaris.launcher",
    "productName": "Solaris",
    "files": [
      "main.js",
      "preload.js",
      "src/**",
      "renderer/**",
      "data/**",
      "assets/**",
      "node_modules/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets/icon.png"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "category": "Game",
      "executableName": "solaris",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "synopsis": "A fast, modern Minecraft: Java Edition launcher",
      "description": "Solaris — a fast, modern Minecraft: Java Edition launcher with mods, modpacks, skins and server hosting.",
      "maintainer": "Ahere12 <Ahere12@users.noreply.github.com>",
      "vendor": "Solaris",
      "desktop": {
        "entry": {
          "Keywords": "minecraft;launcher;game;"
        }
      },
      "mimeTypes": [
        "x-scheme-handler/solaris"
      ],
      "syncDesktopName": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Ahere12",
        "repo": "solairs"
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "protocols": [
      {
        "name": "Solaris link",
        "schemes": [
          "solaris"
        ]
      }
    ],
    "afterPack": "tools/after-pack.js",
    "deb": {
      "depends": [
        "libgtk-3-0 | libgtk-3-0t64",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0 | libatspi2.0-0t64",
        "libuuid1",
        "libsecret-1-0",
        "libasound2 | libasound2t64"
      ],
      "artifactName": "solaris_${version}_amd64.${ext}"
    }
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "electron-updater": "^6.8.11",
    "silent-discord-rpc": "^4.0.1",
    "skinview3d": "^3.4.2"
  },
  "devDependencies": {
    "@fontsource-variable/outfit": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "lucide-static": "^0.577.0"
  },
  "homepage": "https://github.com/Ahere12/solairs",
  "desktopName": "solaris.desktop"
}
